# 运行时数据：SQLite 数据库、爬取日志/进度、截图等（体积大且为生成物，不入库）
/data/

# Python 字节码 / 打包产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 虚拟环境
venv/
.venv/
env/

# 数据库备份 / 合并冲突排查的临时目录
_db_backup/
_dbcheck/

# 本地一次性诊断/基准脚本：只在本机复现问题用，不入库
# 内含 *_scratch（脚本输出、临时服务日志）与 _premove_backup（从仓库根搬来的原件）
/diagnostics/

# 日志
*.log

# 测试 / 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / 编辑器
.idea/
.vscode/

# 操作系统
.DS_Store
Thumbs.db
